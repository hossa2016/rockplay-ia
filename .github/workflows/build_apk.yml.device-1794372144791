name: Build APK

on:
  push:
    branches: [main]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - uses: subosito/flutter-action@v2
        with:
          channel: stable

      # Genera la carpeta android/ si falta (no toca lib/ ni pubspec.yaml)
      - name: Generar proyecto Android
        run: flutter create --platforms=android --project-name rockplay --org com.rockplay .

      # Nombre RockPlay + permisos de internet y audio
      - name: Configurar Android
        run: python3 tools/setup_android.py

      # Icono de la app
      - name: Generar icono
        run: |
          flutter pub add --dev flutter_launcher_icons
          dart run flutter_launcher_icons

      - run: flutter pub get

      - name: Compilar APK
        run: flutter build apk --release

      - uses: actions/upload-artifact@v4
        with:
          name: RockPlay-APK
          path: build/app/outputs/flutter-apk/app-release.apk
